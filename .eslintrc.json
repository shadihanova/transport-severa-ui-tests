{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "playwright"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended", "plugin:playwright/recommended", "prettier"],
  "rules": {
    // Тут можно добавлять кастомные правила.
    // Например, разрешить неиспользуемые переменные, начинающиеся с _ (полезно для моков)
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": ["node_modules/", "playwright-report/", "test-results/", ".auth/"]
}
